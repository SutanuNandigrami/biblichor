# Keep the build context small
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.git/
.github/
docs/screenshots/

# Generated artifacts that we either re-create in the build or don't need
webapp/node_modules/
webapp/dist/
data/
*.db
*.db-wal
*.db-shm
*.log

# Editor cruft
.idea/
.vscode/
*.swp
.DS_Store

# Don't accidentally bake secrets into the image
.env
.env.*
config/config.yaml
data/secrets/
