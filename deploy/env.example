# biblichor environment template — copy to `.env` and fill in.
# `./deploy/bootstrap.sh` does this interactively if you'd rather.

# ============================================================
# REQUIRED
# ============================================================

# Gmail account that does the SMTP send.
# This MUST be an App Password (not your real Gmail password):
#   https://myaccount.google.com/apppasswords
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Your Kindle's send-to-kindle address. Find it at:
#   amazon.com/sendtokindle -> Personal Document Settings
# Important: add GMAIL_USER above to your Approved Personal Document
# E-mail list, or Amazon will reject the send.
KINDLE_EMAIL=your-kindle@kindle.com


# ============================================================
# OPTIONAL — defaults below work for most users
# ============================================================

# Host port for the dashboard (default 8090)
BIBLICHOR_PORT=8090

# Timezone for cron-like scheduler jobs (uses systemd-friendly TZ names)
TZ=Etc/UTC

# FlareSolverr log level — bump to "debug" to troubleshoot CF challenges
FLARESOLVERR_LOG_LEVEL=info

# Set to 1 only if you `docker compose --profile av up`
BIBLICHOR_USE_CLAMAV=0

# ============================================================
# BookOrbit (library UI + reader + Kobo/KOReader/OPDS)
# Generated by bootstrap.sh on first run.
# ============================================================

# Host port for the BookOrbit dashboard (default 3000)
BOOKORBIT_PORT=3000

# External URL used in emails + Kobo endpoints. For Tailscale
# setups, use the Tailscale hostname (e.g. http://claude-1:3000).
BOOKORBIT_URL=http://localhost:3000

# Database credentials. Postgres lives in its own container.
BOOKORBIT_DB_USER=bookorbit
BOOKORBIT_DB_NAME=bookorbit
BOOKORBIT_DB_PASSWORD=<filled-by-bootstrap.sh>

# JWT secret for sessions + setup token for first-run admin
# creation. Both should be long random strings — bootstrap.sh
# generates 32-byte hex by default.
BOOKORBIT_JWT_SECRET=<filled-by-bootstrap.sh>
BOOKORBIT_SETUP_TOKEN=<filled-by-bootstrap.sh>

# Node heap limit (MB). Bump on very large libraries.
BOOKORBIT_NODE_HEAP_MB=2048
