# biblichor environment template — copy to `.env` and fill in.
# `./deploy/bootstrap.sh` does this interactively if you'd rather.

# ============================================================
# REQUIRED
# ============================================================

# Gmail account that does the SMTP send.
# This MUST be an App Password (not your real Gmail password):
#   https://myaccount.google.com/apppasswords
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Your Kindle's send-to-kindle address. Find it at:
#   amazon.com/sendtokindle -> Personal Document Settings
# Important: add GMAIL_USER above to your Approved Personal Document
# E-mail list, or Amazon will reject the send.
KINDLE_EMAIL=your-kindle@kindle.com


# ============================================================
# OPTIONAL — defaults below work for most users
# ============================================================

# Host port for the dashboard (default 8090)
BIBLICHOR_PORT=8090

# Timezone for cron-like scheduler jobs (uses systemd-friendly TZ names)
TZ=Etc/UTC

# FlareSolverr log level — bump to "debug" to troubleshoot CF challenges
FLARESOLVERR_LOG_LEVEL=info

# Set to 1 only if you `docker compose --profile av up`
BIBLICHOR_USE_CLAMAV=0

# Phase 6v.1: docker group ID on the host. Needed only if you want to
# use the in-app "Upgrade BookOrbit" button (Settings page) — biblichor
# uses the host docker.sock and must be a member of the host docker
# group. Find your value with:
#   getent group docker | cut -d: -f3
# Debian/Ubuntu defaults to 999; Docker Desktop / cloud images often
# use 988. Leave unset (or comment out the group_add line in
# compose.yml) to disable the upgrade button — the SPA degrades
# gracefully and the rest of biblichor is unaffected.
DOCKER_GID=999

# ============================================================
# BookOrbit (library UI + reader + Kobo/KOReader/OPDS)
# Generated by bootstrap.sh on first run.
# ============================================================

# Host port for the BookOrbit dashboard (default 3000)
BOOKORBIT_PORT=3000

# Internal URL biblichor uses to talk to BookOrbit's API. In a
# docker compose deployment this is the compose service name
# (default: http://bookorbit:3000). For a native install, this is
# wherever BookOrbit is listening (typically http://localhost:3000).
#
# Note: this is the INTERNAL API URL, NOT what the user sees in
# their browser. The SPA computes the user-facing URL from the
# request hostname automatically (so Tailscale names / LAN IPs
# Just Work without per-device config). Only set BOOKORBIT_EXTERNAL_URL
# below if you publish BookOrbit at a different hostname than
# biblichor (e.g. reverse-proxy / split-DNS setups).
BOOKORBIT_URL=http://bookorbit:3000

# Optional: explicit user-facing URL override for SPA links. Leave
# blank in 99% of setups — the SPA auto-derives this from the
# request hostname. Set ONLY for reverse-proxy / split-DNS where
# the browser must use a different hostname than biblichor.
#BOOKORBIT_EXTERNAL_URL=https://books.example.com

# Database credentials. Postgres lives in its own container.
BOOKORBIT_DB_USER=bookorbit
BOOKORBIT_DB_NAME=bookorbit
BOOKORBIT_DB_PASSWORD=<filled-by-bootstrap.sh>

# JWT secret for sessions + setup token for first-run admin
# creation. Both should be long random strings — bootstrap.sh
# generates 32-byte hex by default.
BOOKORBIT_JWT_SECRET=<filled-by-bootstrap.sh>
BOOKORBIT_SETUP_TOKEN=<filled-by-bootstrap.sh>

# Node heap limit (MB). Bump on very large libraries.
BOOKORBIT_NODE_HEAP_MB=2048
