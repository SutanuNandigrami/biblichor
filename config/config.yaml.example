general:
  poll_interval_minutes: 60
  process_interval_minutes: 10
  retry_interval_hours: 6
  mirror_refresh_hours: 6
  retention_hour_utc: 3
  retention_keep_events: 50000
  retention_keep_events_days: 90
  retention_keep_bench_per_scraper: 200
  max_attempts: 5
  books_dir: /data/books
  log_level: INFO
  daily_summary_hour_utc: 14
  timezone: Asia/Kolkata
  auto_pick_threshold: 70
  auto_pick_threshold_non_latin: 45
  auto_pick_gap: 10
  min_score_for_failure: 40
  min_score_for_failure_non_latin: 25
  zombie_stale_minutes: 30
  fallthrough_quality_floor: 60
  fallthrough_quality_floor_non_latin: 40
kindle:
  recipient: ''
  subject: '{title}'
  attachment_max_mb: 50
smtp:
  host: smtp.gmail.com
  port: 587
  starttls: true
  max_attachment_mb: 22
pushover:
  enabled: false
  events:
    book_sent: true
    book_needs_review: true
    cycle_summary: true
calibre:
  enabled: true
  output_profile: kindle_pw3
  conversion_timeout_seconds: 300
scrapers:
  order:
  - annas_curl
  - annas_flaresolverr
  - annas_cloakbrowser
  - welib_curl
  - welib_playwright
  - libgen_curl
  - archive_curl
  - kindlebangla_curl
  enabled:
    annas_curl: true
    annas_flaresolverr: true
    annas_playwright: false
    annas_cloakbrowser: true
    welib_curl: true
    welib_playwright: true
    libgen_curl: true
    archive_curl: true
    kindlebangla_curl: true
  format_priority:
  - epub
  - azw3
  - mobi
  - pdf
  language: en
  request_delay_seconds: 6
  slow_download_timeout_seconds: 180
  flaresolverr_url: http://flaresolverr:8191/v1
  annas_mirrors:
  - https://annas-archive.gl
  - https://annas-archive.pk
  - https://annas-archive.gd
  bdebooks:
    excluded_categories:
      - "Islamic Books"
      - "ইসলামিক বই"
      - "Islamic"
      - "Islam"
      - "Religion"
      - "Religious"
      - "ধর্ম"
      - "ধর্মীয়"
      - "Hadith"
      - "হাদিস"
      - "Quran"
      - "কোরআন"
      - "Prophet"
      - "নবী"
      - "Islamic Studies"
      - "ইসলামিক স্টাডিজ"
  kindlebangla:
    excluded_categories:
      - "Islamic"
      - "Religion"
      - "Religious"
      - "ধর্মীয়"
      - "Hadith"
      - "Quran"
scoring:
  isbn_match: 35
  title_weight: 25
  author_weight: 15
  format_bonus:
    epub: 10
    azw3: 9
    mobi: 8
    pdf: 5
  language_bonus: 10
  filesize_min_bytes: 200000
  filesize_max_bytes: 83886080
  scan_penalty: 10
  non_latin_title_multiplier: 2.0
  audio_keywords:
  - audiobook
  - audible
  - mp3
  - m4b
security:
  require_clamav: false
  max_archive_size_mb: 200
  max_extracted_size_mb: 500
  max_members: 50
