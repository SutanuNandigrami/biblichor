general:
  poll_interval_minutes: 60
  process_interval_minutes: 10
  retry_interval_hours: 6
  mirror_refresh_hours: 6
  retention_hour_utc: 3
  retention_keep_events: 50000
  retention_keep_events_days: 90
  retention_keep_bench_per_scraper: 200
  max_attempts: 5
  books_dir: /data/books
  log_level: INFO
  daily_summary_hour_utc: 14
  timezone: Asia/Kolkata
  auto_pick_threshold: 70.0
  auto_pick_threshold_non_latin: 45.0
  fallthrough_quality_floor: 60.0
  # Stop searching and park book as "skipped" after this many failed search rounds
  max_search_attempts_before_skip: 3
  fallthrough_quality_floor_non_latin: 40.0
  auto_pick_gap: 10.0
  min_score_for_failure: 40.0
  min_score_for_failure_non_latin: 25.0
  zombie_stale_minutes: 30
kindle:
  recipient: ''
  subject: '{title}'
  attachment_max_mb: 50
smtp:
  host: smtp.gmail.com
  port: 587
  starttls: true
  user: ''
  password: ''
  max_attachment_mb: 24
  # Gmail free tier outbound limit ~100/day. Default 80 leaves headroom
  # for non-Kindle mail. 0 disables the gate.
  daily_cap: 80
pushover:
  enabled: false
  user_key: ''
  app_token: ''
  events:
    book_sent: true
    book_needs_review: true
    cycle_summary: true
calibre:
  enabled: true
  output_profile: kindle_pw3
  conversion_timeout_seconds: 300
scrapers:
  order:
  - annas_curl
  - annas_flaresolverr
  - annas_cloakbrowser
  - annas_patchright
  - welib_curl
  - welib_playwright
  - libgen_curl
  - archive_curl
  - kindlebangla_curl
  enabled:
    annas_curl: true
    annas_flaresolverr: true
    annas_playwright: false
    annas_cloakbrowser: true
    # annas_patchright drives stealth-Chromium (patchright) to bypass
    # the DDoS-Guard challenge annas-archive.gl deployed on
    # /slow_download/. The browser launch is ~150 MB RAM + ~20 s per
    # book — keep it ordered AFTER the cheaper annas variants so it
    # only fires when those return None.
    annas_patchright: true
    welib_curl: true
    welib_playwright: true
    libgen_curl: true
    archive_curl: true
    kindlebangla_curl: true
    gutendex: true
    standard_ebooks: true
    oapen_doab: true
    wikisource: true
    zlib_singlelogin: true
  format_priority:
  - epub
  - azw3
  - mobi
  - pdf
  language: en
  request_delay_seconds: 6.0
  slow_download_timeout_seconds: 180
  flaresolverr_url: http://flaresolverr:8191/v1
  # Route Anna's onion fallback through the Tor sidecar. Enable via
  # `docker compose --profile tor up -d` and flip tor_enabled to true.
  # NOTE (2026-06-16 probe): Anna's currently only advertises a *torrents*
  # onion (c5tbehd6apsmqyf5p4cfgky2njxd3tz37nrpt7qur6p7rczsuakqxkqd.onion)
  # and that host was unreachable through the Tor sidecar (DDG/sanity onion
  # responded fine, so tor itself is healthy). No main-site onion exists at
  # the moment, so flipping this on does nothing useful. The plumbing stays
  # in place for if/when Anna's brings one back up.
  tor_enabled: false
  tor_proxy_url: socks5h://tor:9050
  annas_mirrors:
  - https://annas-archive.gl
  - https://annas-archive.pk
  - https://annas-archive.gd
  # Paste the full Cookie: header from a logged-in welib.org browser session.
  # Enables /fast_download/ path. Leave null when not using welib auth.
  welib_auth_cookie: null
  # Books published within this many years are treated as recent releases
  # and get mobilism_books promoted to the front of the scraper chain.
  recent_release_window_years: 1
  mobilism_username: ''
  mobilism_password: ''
  bdebooks:
    excluded_categories:
      - "Islamic Books"
      - "ইসলামিক বই"
      - "Islamic"
      - "Islam"
      - "Religion"
      - "Religious"
      - "ধর্ম"
      - "ধর্মীয়"
      - "Hadith"
      - "হাদিস"
      - "Quran"
      - "কোরআন"
      - "Prophet"
      - "নবী"
      - "Islamic Studies"
      - "ইসলামিক স্টাডিজ"
  kindlebangla:
    excluded_categories:
      - "Islamic"
      - "Religion"
      - "Religious"
      - "ধর্মীয়"
      - "Hadith"
      - "Quran"
scoring:
  isbn_match: 35
  title_weight: 25
  author_weight: 15
  format_bonus:
    epub: 10
    azw3: 9
    mobi: 8
    pdf: 5
  language_bonus: 10
  filesize_min_bytes: 200000
  filesize_max_bytes: 83886080
  scan_penalty: 10
  non_latin_title_multiplier: 2.0
  # If set, candidates whose filesize_bytes exceeds this are hard-skipped.
  # Leave null to let pipeline compute dynamically from smtp.max_attachment_mb.
  deliverable_max_bytes: null
  audio_keywords:
  - audiobook
  - audible
  - mp3
  - m4b
security:
  require_clamav: false
  max_archive_size_mb: 200
  max_extracted_size_mb: 500
  max_members: 50
storage:
  # backend: local | rclone | hybrid
  # local   - files live under general.books_dir
  # rclone  - all I/O goes to an rclone remote (gdrive / s3 / hetzner / ...)
  # hybrid  - primary=local, backup=rclone mirror
  backend: local
  local_root: ''
  rclone_remote: ''
  rclone_bucket_path: ''
  hybrid_mode: mirror
bookorbit:
  # Flip enabled after running `biblichor bookorbit-setup`
  enabled: false
  url: ''
  library_root: ''
  organization_mode: book_per_folder
  library_id: ''
bench:
  per_query_timeout_sec: 45
  circuit_break_after_consecutive_fails: 3
stk:
  # Send-to-Kindle (browser-upload) delivery. Needs OAuth setup via the
  # Settings page before it can be used.
  # daily_cap: null means unlimited; set an integer to gate on rolling 24h count.
  daily_cap: null
  max_attempts: 3
  backoff_initial_sec: 5.0
  backoff_factor: 3.0
  client_id: null
  amazon_domain: amazon.com
  # Minimum gap between consecutive STK sends (seconds). Guards against
  # Amazon anti-abuse threshold that can revoke the device cert.
  min_send_interval_sec: 10.0
  # Sleep between files within a single batch. Amazon's detection is
  # rate-based, not session-based -- 8 files in 19s triggered revocation
  # in practice. Default 10.0 s is the safe floor.
  per_file_interval_sec: 10.0
  max_batch_files: 25
  max_batch_bytes: 209715200
