general:
  poll_interval_minutes: 60
  max_attempts: 5
  books_dir: /data/books
  log_level: INFO
  daily_summary_hour_utc: 14
  timezone: Asia/Kolkata
  auto_pick_threshold: 70
  auto_pick_gap: 10
  min_score_for_failure: 40
  zombie_stale_minutes: 30

kindle:
  recipient: ""
  subject: "{title}"
  attachment_max_mb: 50

smtp:
  host: smtp.gmail.com
  port: 587
  starttls: true

pushover:
  enabled: false
  events:
    book_sent: true
    book_needs_review: true
    cycle_summary: true

calibre:
  enabled: true
  output_profile: kindle_pw3
  conversion_timeout_seconds: 300

scrapers:
  order:
    - annas_curl
    - annas_flaresolverr
    - annas_cloakbrowser
    - welib_curl
    - welib_playwright
    - libgen_curl
    - archive_curl
    - kindlebangla_curl
  enabled:
    annas_curl: true
    annas_flaresolverr: true
    annas_playwright: false
    annas_cloakbrowser: true
    welib_curl: true
    welib_playwright: true
    libgen_curl: true
    archive_curl: true
    kindlebangla_curl: true
  format_priority: [epub, azw3, mobi, pdf]
  language: en
  request_delay_seconds: 6
  slow_download_timeout_seconds: 180
  flaresolverr_url: http://flaresolverr:8191/v1
  annas_mirrors:
    - https://annas-archive.gl
    - https://annas-archive.pk
    - https://annas-archive.gd

scoring:
  isbn_match: 35
  title_weight: 25
  author_weight: 15
  format_bonus: { epub: 10, azw3: 9, mobi: 8, pdf: 5 }
  language_bonus: 10
  filesize_min_bytes: 200000
  filesize_max_bytes: 83886080
  scan_penalty: 10
  audio_keywords: [audiobook, audible, mp3, m4b]

security:
  # When false (default), ClamAV is run if installed but absence is OK.
  # When true, the pipeline refuses to unpack archives unless clamscan
  # is on PATH. Install: sudo apt install clamav clamav-daemon
  require_clamav: false
  max_archive_size_mb: 200
  max_extracted_size_mb: 500
  max_members: 50
